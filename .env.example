# ============================================================================
# Estudatta — variáveis de ambiente (copie para .env; nunca versione segredos)
# Usado pelo Docker Compose (infra/) e pelo backend (pydantic-settings).
# ============================================================================

# --- Ambiente ----------------------------------------------------------------
APP_ENV=development                # development | test | production
APP_NAME=Estudatta
APP_URL=http://localhost:5180      # origem do app/PWA (produção: https://app.estudatta.com.br)
API_URL=http://localhost:8020      # origem da API (produção: https://app.estudatta.com.br, mesma origem do app)
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
LOG_LEVEL=INFO

# --- Banco e filas -----------------------------------------------------------
# Portas publicadas no host pelo Compose (mude se já estiverem em uso)
POSTGRES_PORT=5450
REDIS_PORT=6400
MAILPIT_SMTP_PORT=1050
MAILPIT_UI_PORT=8050
API_PORT=8020
WEB_PORT=8090
POSTGRES_USER=estudatta
POSTGRES_PASSWORD=estudatta
POSTGRES_DB=estudatta
DATABASE_URL=postgresql+psycopg://estudatta:estudatta@localhost:5450/estudatta
REDIS_URL=redis://localhost:6400/0

# --- Sessões / segurança -----------------------------------------------------
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                # true em produção (HTTPS obrigatório)
# COOKIE_DOMAIN=estudatta.com.br
# Origens autorizadas a chamar a API pelo navegador: o site público (repositório separado) usa
# GET /public/plans, POST /public/waitlist e POST /public/contact. Produção: https://estudatta.com.br
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
# TRUSTED_ORIGINS=http://localhost:5180
RATE_LIMIT_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false   # true para exigir confirmação antes de entrar

# --- E-mail ------------------------------------------------------------------
EMAIL_BACKEND=smtp                 # smtp | console | memory
SMTP_HOST=localhost                # em dev, o Mailpit do Compose (host "mailpit" dentro do Docker)
SMTP_PORT=1050
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_STARTTLS=false
EMAIL_FROM="Estudatta <no-reply@estudatta.com.br>"

# --- Google OAuth (opcional; sem valores o botão não aparece) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web Push / VAPID (gere com: make vapid) ---------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@estudatta.com.br

# --- Armazenamento de materiais ---------------------------------------------
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_PATH=var/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=800
PDF_EXTRACTION_TIMEOUT_SECONDS=120
OCR_ENABLED=false                  # requer tesseract instalado na imagem do worker

# --- Cobrança (Mercado Pago) ------------------------------------------------
BILLING_PROVIDER=mercadopago
BILLING_MODE=disabled              # disabled | test | production
MERCADOPAGO_ACCESS_TOKEN=          # credencial de TESTE para BILLING_MODE=test
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=        # "assinatura secreta" configurada no painel de webhooks

# --- IA opcional (API compatível com OpenAI) --------------------------------
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_ACTIONS_FREE=0
AI_DAILY_ACTIONS_PRO=20
AI_GLOBAL_DAILY_BUDGET_ACTIONS=2000

# --- Notificações -----------------------------------------------------------
NOTIFICATIONS_MAX_PROACTIVE_PER_DAY=3
NOTIFICATIONS_SYSTEM_CEILING_PER_DAY=6

# --- Métricas de conversão (opcional; respeita consentimento) ---------------
ANALYTICS_PROVIDER=none            # none | plausible | ga4
ANALYTICS_SITE_ID=

# --- Demonstração -------------------------------------------------------------
DEMO_MODE=false                    # seeds de demonstração explicitamente separados

# --- Frontend (Vite) ----------------------------------------------------------
VITE_API_URL=                      # vazio = mesma origem (/api). Em dev, o Vite faz proxy para API_URL
