# Nginx do servidor (fora do Docker), com TLS, na frente dos dois containers:
#   - site público (repositório estudatta-site)  → estudatta.com.br      → 127.0.0.1:8091
#   - app (PWA) + API (este repositório)          → app.estudatta.com.br  → 127.0.0.1:8090 (WEB_PORT)
# Certificados: certbot --nginx -d estudatta.com.br -d www.estudatta.com.br -d app.estudatta.com.br

server {
    listen 80;
    server_name estudatta.com.br www.estudatta.com.br app.estudatta.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.estudatta.com.br;
    ssl_certificate /etc/letsencrypt/live/estudatta.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/estudatta.com.br/privkey.pem;
    return 301 https://estudatta.com.br$request_uri;
}

# Site público
server {
    listen 443 ssl http2;
    server_name estudatta.com.br;
    ssl_certificate /etc/letsencrypt/live/estudatta.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/estudatta.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Links antigos do app no domínio principal continuam funcionando
    location ~ ^/(app|entrar|cadastro|onboarding|confirmar-email|recuperar-senha|redefinir-senha|admin)(/|$) {
        return 301 https://app.estudatta.com.br$request_uri;
    }

    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# App (PWA) + API na mesma origem
server {
    listen 443 ssl http2;
    server_name app.estudatta.com.br;
    ssl_certificate /etc/letsencrypt/live/estudatta.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/estudatta.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
