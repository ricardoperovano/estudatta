# Nginx do servidor compartilhado → API do Estudatta (docker-compose.server.yml).
# Cloudflare na frente (proxy laranja, SSL "Full (strict)") com Certificado de Origem da
# Cloudflare em /etc/ssl/cloudflare/. Só ative depois que os dois arquivos existirem:
# um certificado ausente impede o "nginx -t" e bloquearia o reload dos outros sites.
#
#   cp infra/nginx/api.estudatta.com.br.conf.example /etc/nginx/sites-available/api.estudatta.com.br
#   ln -s /etc/nginx/sites-available/api.estudatta.com.br /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name api.estudatta.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.estudatta.com.br;

    ssl_certificate     /etc/ssl/cloudflare/estudatta.com.br.pem;
    ssl_certificate_key /etc/ssl/cloudflare/estudatta.com.br.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 30m;   # uploads de material (MAX_UPLOAD_MB=25)
    access_log /var/log/nginx/api.estudatta.access.log;
    error_log  /var/log/nginx/api.estudatta.error.log;

    # só a API; qualquer outro caminho é 404
    location /api/ {
        proxy_pass http://127.0.0.1:18120;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    location / { return 404; }
}
